{
  "version": "1.0.0",
  "target": 3,
  "noCleanup": false,
  "modelPath": "pretrained_models/small_mlp_mnist.h5",
  "inputShape": "784",
  "outputPath": "deepcraft",
  "cPrefix": "IMAI_",
  "outputModelName": "TEST_MODEL",
  "quantizationEnabled": true,
  "quantizationType": 1,
  "sparsityEnabled": false,
  "quantizationData": {
    "type": 1,
    "path": "sample_data/mnist_calib_data.csv",
    "startColumn": 0,
    "numColumn": 100000000,
    "sampleCount": 1000
  },
  "float32Api": false,
  "zeroCopyApi": false,
  "validationEnabled": true,
  "validationData": {
    "type": 1,
    "path": "sample_data/mnist_test_data.csv",
    "startColumn": 0,
    "numColumn": 100000000,
    "sampleCount": 1000
  },
  "useOriginalModelReference": false,
  "useFloatReference": false,
  "useProvidedReference": false,
  "interpreterless": false,
  "useExecuTorch": false,
  "isModelRnn": false,
  "ethosUSystemConfig": 0,
  "ethosUMemoryMode": 0,
  "ethosUOptimize": 1,
  "ethosUTensorAllocator": 2,
  "ethosUArenaCacheSize": 2936012,
  "ethosUArenaSizeStrategy": 1,
  "ethosUForcePythonBackend": false,
  "ethosURecursionLimit": 1000,
  "ethosUMaxBlockDependency": 3,
  "overrideArenaSize": 0,
  "arenaAllocation": 0,
  "weightsMode": 0,
  "validationBaudRate": 1000000,
  "validationQuantizationType": "int8x8",
  "validationVisualSamplesAll": true,
  "validationVisualSamplesCount": 100,
  "validationRunDesktop": false,
  "validationRunTarget": true,
  "validationDesktopAllQuantizations": false,
  "targetApi": 0,
  "mlCoretoolsPathOverride": "",
  "mlCoretoolsConfigOverride": "",
  "mlCoretoolsCliArguments": "{command}",
  "verboseOutput": false
}